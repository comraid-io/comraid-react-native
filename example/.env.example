# Publishable App ID from the ComRaid dashboard (cr_app_…).
EXPO_PUBLIC_COMRAID_APP_ID=cr_app_replace_me

# Optional — local server or staging.
# EXPO_PUBLIC_COMRAID_API_BASE_URL=http://127.0.0.1:8080

# Contact External user ID used by the Login button.
EXPO_PUBLIC_COMRAID_EXTERNAL_USER_ID=example_user_1

# Optional Identity verification JWT for Login.
# EXPO_PUBLIC_COMRAID_JWT=

# iOS APNs environment for the Expo config plugin + initialize().
EXPO_PUBLIC_COMRAID_APNS_ENVIRONMENT=sandbox

# Path to Firebase Android config (relative to example/). Required for Android prebuild.
# GOOGLE_SERVICES_JSON=./google-services.json
